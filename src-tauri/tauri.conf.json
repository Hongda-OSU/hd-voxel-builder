{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HD Voxel Builder",
  "version": "0.1.0",
  "identifier": "com.hongda.voxelbuilder",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "HD 体素工坊",
      "width": 1180,
      "height": 780,
      "minWidth": 800,
      "minHeight": 720,
      "center": true,
      "backgroundColor": "#0b0d11"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "category": "GraphicsAndDesign",
    "shortDescription": "A local voxel workshop",
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
